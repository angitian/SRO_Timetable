# Cloudflare D1 (REST API) — required only for the cloud-backed timetables store.
# If any of these are blank, the backend automatically falls back to a local
# JSON-file store (backend/data/timetables.json) so dev keeps working offline.
#
# Create the database in the Cloudflare dashboard, then copy the values from
# Workers & Pages → D1 → <your database> → "Database ID" and your account ID
# (top-right corner). Create an API token with the "D1 Edit" permission at
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Origin of the deployed frontend, used to build shareable short-link URLs
# returned by POST /api/v1/timetables/generate-and-save.
# Examples:
#   http://localhost:5173                       (local dev)
#   https://sro-timetable-frontend.<acct>.workers.dev
FRONTEND_BASE_URL=http://localhost:5173

# ── Google OAuth (optional — enables cloud save/load + login) ──────────────
# When all three (CLIENT_ID, CLIENT_SECRET, JWT_SECRET) are set, the /auth/*
# endpoints are enabled and users can log in with Google to save workspaces
# to the cloud. When not set, the app works in guest mode (device id only).
#
# Setup:
# 1. Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URIs:
#      http://localhost:8000/api/v1/auth/google/callback          (dev)
#      https://<your-render-app>.onrender.com/api/v1/auth/google/callback  (prod)
# 4. Copy the Client ID and Client Secret here
# 5. Generate a JWT secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT signing secret (HS256) for SRO-issued access tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Backend origin — used to build the Google OAuth redirect URI.
# Examples:
#   http://localhost:8000                    (local dev)
#   https://<your-render-app>.onrender.com   (prod)
BACKEND_BASE_URL=http://localhost:8000
